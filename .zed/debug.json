// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Producer",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/build/debug/apps/producer/producer",
    "build": {
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "debug"
      ]
    }
  },
  {
    "label": "Consumer",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/build/debug/apps/consumer/consumer",
    "build": {
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "debug"
      ]
    }
  }
]
